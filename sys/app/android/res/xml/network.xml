<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Besides the system's authorities, the ones the owner installed on the phone are trusted:
     Aurora's own (Caddy's local authority, aurora-ca.crt) is one of them. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
