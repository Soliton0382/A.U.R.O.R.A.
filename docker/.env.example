# Aurora in Docker — the few choices (copy to docker/.env and edit; guide: docs/DOCKER.md).
# Read at the FIRST start to write Aurora's own settings (/data/.env in the volume); after that Aurora's settings are
# changed from the WebUI. The ports, the address and its other names are read again at every start.

# ---- where Aurora is reached ---------------------------------------------------------------------------------------
# This computer's address on the home network (the phone opens https://<it>), or localhost for this computer only
AURORA_DOMAIN=192.168.1.20
# Other names of this computer, comma-separated (its name.local, localhost)
AURORA_DOMAIN_ALIASES=localhost
# Ports: 443/80 are the usual ones; if another service already uses them choose others (e.g. 8443 and 8080).
# The same port is published outside and used inside. To change them: edit here, then «docker compose ... up -d».
AURORA_HTTPS_PORT=443
AURORA_HTTP_PORT=80

# ---- the cloud reasoner -------------------------------------------------------------------------------------------
# anthropic | openai | google | mistral | openrouter | xai | custom (an OpenAI-compatible service: vLLM, LM Studio...)
AURORA_CLOUD_PROVIDER=anthropic
# The model, as the provider names it; empty = the first of the provider's own list (tried at the first start)
AURORA_CLOUD_MODEL=
# The key of the chosen provider only (the others stay empty)
AURORA_ANTHROPIC_API_KEY=
AURORA_OPENAI_API_KEY=
AURORA_GOOGLE_API_KEY=
AURORA_MISTRAL_API_KEY=
AURORA_OPENROUTER_API_KEY=
AURORA_XAI_API_KEY=
# custom only: the address ending in /v1, and its key if it asks one
AURORA_CUSTOM_BASE_URL=
AURORA_CUSTOM_API_KEY=

# ---- who ----------------------------------------------------------------------------------------------------------
AURORA_OWNER_NAME=
AURORA_ASSISTANT_NAME=Aurora
AURORA_LANG_DEFAULT=it_IT
# single (one person) or multi (several, each with a password and an Authenticator code)
AURORA_USER_MODE=single

# ---- a small machine ----------------------------------------------------------------------------------------------
# The harvester fills the empty vault with open papers; on a small CPU it keeps the encoder busy (1 = on, 0 = off)
AURORA_HARVEST_ENABLED=1
# The most memory the container may use (the encoder and re-ranker take ~5 GB while they work)
AURORA_MEMORY_LIMIT=10g
# More models to download at the first start, comma-separated (e.g. stt for dictation; empty = none)
AURORA_DOCKER_MODELS=
