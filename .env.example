# Aurora environment. Generated from sys/core/config/settings_schema.json;
# edit the values here or from the WebUI Settings page.


# ---- Installation root -------------------------------------------------------

# Absolute path of the installation. Every other path is relative to it. Moving or renaming the installation means changing only this value and re-running the service installer.
# [path_abs]  recommended: /opt/aurora  evidence: the installer writes the real folder
AURORA_ROOT=/opt/aurora


# ---- Folders -----------------------------------------------------------------

# Code of the core.
# [path]  recommended: sys/core  evidence: owner
AURORA_CORE_DIR=sys/core

# The vault: knowledge and memory shards.
# [path]  recommended: sys/vault  evidence: owner
AURORA_VAULT_DIR=sys/vault

# Vector indexes, rebuildable from the vault at any time.
# [path]  recommended: sys/vault/index  evidence: owner
AURORA_INDEX_DIR=sys/vault/index

# Model weights.
# [path]  recommended: sys/models  evidence: owner
AURORA_MODELS_DIR=sys/models

# Logs: one folder per component, plus trace/.
# [path]  recommended: sys/logs  evidence: owner
AURORA_LOG_DIR=sys/logs

# Runtime state and benchmark results.
# [path]  recommended: sys/status  evidence: owner
AURORA_STATUS_DIR=sys/status

# The security plugin's working folder (the firewall's lock, Aurora's changes, the threat hunt's memory, the manual's index): the folder security inside AURORA_STATUS_DIR. The plugin's sandbox may write here only.
# [path]  recommended: sys/status/security  evidence: C195, 2026-10-08
AURORA_SECURITY_DIR=sys/status/security

# Sandbox where forged agents and plugins are tested.
# [path]  recommended: sys/sandbox  evidence: owner
AURORA_SANDBOX_DIR=sys/sandbox

# Python virtual environment used by the services.
# [path]  recommended: .venv  evidence: owner
AURORA_VENV_DIR=.venv

# Caddyfile, certificates and Caddy logs.
# [path]  recommended: sys/https  evidence: owner
AURORA_HTTPS_DIR=sys/https


# ---- Vault and solitons ------------------------------------------------------

# Target length of a knowledge soliton in characters. Smaller chunks were within noise on retrieval and cost 2.8x-4.7x the vectors. Legal texts use the article as unit instead.
# [int]  recommended: 4000  evidence: M5, M6, M8
AURORA_CHUNK_CHARS=4000

# Chunks of a document split into several chunks that are shorter than this are not forged (the tail of a long text). A complete short document, such as a law article, is always kept. Does not apply to conversation turns.
# [int]  recommended: 300  evidence: INITIAL
AURORA_CHUNK_MIN_CHARS=300

# pdftotext executable (poppler-utils), used to read PDF documents on import.
# [path_abs]  recommended: /usr/bin/pdftotext  evidence: owner
AURORA_PDFTOTEXT_BIN=/usr/bin/pdftotext


# ---- Knowledge acquisition (arXiv) -------------------------------------------

# arXiv search API (Atom). Only titles, abstracts and PDFs are read; nothing is sent but the search queries.
# [str]  recommended: https://export.arxiv.org/api/query  evidence: owner
AURORA_ARXIV_API=https://export.arxiv.org/api/query

# Search rounds before giving up. Each round asks for new queries, informed by the titles already seen. One round found the source 1 time in 17 (M22).
# [int]  recommended: 3  evidence: M22
AURORA_ARXIV_ROUNDS=3

# Search queries written by the reasoner per round.
# [int]  recommended: 3  evidence: INITIAL
AURORA_ARXIV_QUERIES=3

# Results read (title and abstract) per query; all of them are re-ranked against the question.
# [int]  recommended: 20  evidence: INITIAL
AURORA_ARXIV_RESULTS=20

# Best-ranked papers downloaded and imported per round.
# [int]  recommended: 3  evidence: M22
AURORA_ARXIV_PAPERS=3

# Besides arXiv, the sources the search agent asks when Aurora does not know (europepmc, wikipedia, github; empty = arXiv only). The re-ranker picks the best among all.
# [str]  recommended: europepmc,wikipedia,github  evidence: owner
AURORA_ACQUIRE_SOURCES=europepmc,wikipedia,github

# When the vault does not answer, Aurora searches the sources and imports by herself instead of asking «sì, cerca» (Autonomy panel, knowledge).
# [bool]  recommended: 0  evidence: owner, 2026-10-05
AURORA_ACQUIRE_AUTO=0

# Pause between two calls to arXiv; their terms of use ask for at least 3 seconds.
# [int]  recommended: 3  evidence: arXiv API terms
AURORA_ARXIV_DELAY_S=3


# ---- Attachments (images, documents) -----------------------------------------

# Longest side of an attached image as the reasoner sees it; larger images are scaled down. 768 px: 605 prompt tokens, 6.5 s for a description.
# [int]  recommended: 1024  evidence: INITIAL
AURORA_VISION_MAX_PX=1024

# Largest attachment accepted, per file.
# [int]  recommended: 50  evidence: INITIAL
AURORA_ATTACH_MAX_MB=50

# Largest video that can be attached to a message.
# [int]  recommended: 500  evidence: a few minutes of phone video
AURORA_VIDEO_MAX_MB=500

# Only the first seconds of a video that are watched and listened to.
# [int]  recommended: 600  evidence: M48: the transcript runs on the CPU at about half real time
AURORA_VIDEO_MAX_S=600

# Frames of a video shown to Aurora's vision (scene changes first).
# [int]  recommended: 12  evidence: M48: one vision call with all frames fits the 32k context
AURORA_VIDEO_FRAMES=12

# Where the files attached in the chat are kept, so that the conversation shows them again (private, 0600).
# [path]  recommended: usr/uploads  evidence: owner
AURORA_UPLOADS_DIR=usr/uploads

# Days an attached file is kept; 0 = as long as its conversation turn (until a memory reset or the owner deletes it).
# [int]  recommended: 0  evidence: owner
AURORA_UPLOADS_KEEP_DAYS=0

# A file deleted from the Files page goes to the trash (restorable) instead of being removed at once.
# [bool]  recommended: 1  evidence: owner
AURORA_TRASH_ENABLED=1

# Days a file stays in the trash before it is removed for good (checked every night).
# [int]  recommended: 30  evidence: owner
AURORA_TRASH_DAYS=30

# Your music for the DJ: the tracks you upload, and the mixes in its mixes/ folder (each user their own).
# [path]  recommended: usr/music  evidence: owner
AURORA_MUSIC_DIR=usr/music

# Longest part of a track the DJ uses, in minutes (a remix of a longer track is cut there).
# [int]  recommended: 12  evidence: owner
AURORA_DJ_MAX_MINUTES=12

# Your health folder (diet, training, exams), sealed with your own key; never sent to a cloud model.
# [path]  recommended: usr/health  evidence: owner
AURORA_HEALTH_DIR=usr/health

# Aurora's own calendar (appointments and reminders), sealed with your own key.
# [path]  recommended: usr/calendar  evidence: owner
AURORA_CALENDAR_DIR=usr/calendar

# FLUX.2 klein 4B: picture edits in words (optional model).
# [path]  recommended: sys/models/image/FLUX.2-klein-4B  evidence: models.json
AURORA_EDIT_MODEL_DIR=sys/models/image/FLUX.2-klein-4B

# Wan 2.2 TI2V 5B: short videos from words or from a picture (optional model).
# [path]  recommended: sys/models/video/Wan2.2-TI2V-5B  evidence: models.json
AURORA_VIDEO_MODEL_DIR=sys/models/video/Wan2.2-TI2V-5B

# Size of a video from words (WxH, multiples of 32; 704x1280 for portrait). A video from a picture keeps the picture's shape with the same area. Wan 2.2 TI2V 5B is trained at 1280x704.
# [str]  recommended: 1280x704  evidence: M57
AURORA_VIDEO_SIZE=1280x704

# Length of a video in seconds (24 frames per second). 5 s is the length the model is trained for; the time grows with the length.
# [float]  recommended: 5  evidence: M57
AURORA_VIDEO_SECONDS=5

# Denoising steps of a video: more steps, more detail and more time (measured: 28 s per step plus ~216 s fixed for 5 s at 1280x704; 30 steps about 18 minutes, 50 about 27).
# [int]  recommended: 30  evidence: M57
AURORA_VIDEO_STEPS=30

# Longest a video job may take before it is stopped (the reasoner is started again anyway). The ceiling is 50 steps, about 1,620 s measured: 2,700 leaves room.
# [int]  recommended: 2700  evidence: M57
AURORA_VIDEO_TIMEOUT_S=2700

# GPU memory a video needs (measured peaks with the transformer weights stored in fp8: 10.9 GB from words, 13.9 GB from a picture): with less free, the reasoner is stopped for the job.
# [float]  recommended: 14  evidence: M57
AURORA_VIDEO_MIN_FREE_GB=14

# Swin2SR x4: enlarging pictures (optional model).
# [path]  recommended: sys/models/image/swin2SR-realworld-x4  evidence: models.json
AURORA_UPSCALE_MODEL_DIR=sys/models/image/swin2SR-realworld-x4

# SAM 2.1: cutting out the subject, background removal (optional model).
# [path]  recommended: sys/models/image/sam2.1-hiera-small  evidence: models.json
AURORA_SEGMENT_MODEL_DIR=sys/models/image/sam2.1-hiera-small


# ---- Vault and solitons ------------------------------------------------------

# When a shard file reaches this size a new shard is opened for that domain. Keeps files portable and backups incremental.
# [int]  recommended: 2048  evidence: INITIAL
AURORA_VAULT_SHARD_MAX_MB=2048


# ---- Embedder ----------------------------------------------------------------

# Encoder of solitons and questions. Qwen3-Embedding-0.6B: rank-1 76.9% (Italian question) vs 71.3% of bge-m3 on the same pool; provisional until re-checked on the new vault.
# [path]  recommended: sys/models/embedder/Qwen3-Embedding-0.6B  evidence: M18
AURORA_EMBEDDER_DIR=sys/models/embedder/Qwen3-Embedding-0.6B

# Vector dimension produced by the encoder.
# [int]  recommended: 1024  evidence: M18
AURORA_EMBEDDER_DIM=1024

# Instruction prepended to questions (not to solitons). The official prompt matters: a custom one cost 21 points of rank-1.
# [str]  recommended: Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:  evidence: M18 (retraction of M8)
AURORA_EMBEDDER_QUERY_PROMPT=Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:

# Device of the encoder. GPU 1 (PCIe x4, slow to load) holds the resident models; GPU 0 (PCIe 5.0 x8) is kept for swaps.
# [str]  recommended: cuda:1  evidence: M23
AURORA_EMBEDDER_DEVICE=cuda:1

# Numeric precision of the encoder.
# [enum, float16/bfloat16/float32]  recommended: float16  evidence: M8, M18
AURORA_EMBEDDER_DTYPE=float16

# Longest input the encoder reads. p95 of a 4,000-character chunk is 1,648 tokens.
# [int]  recommended: 2560  evidence: M5
AURORA_EMBEDDER_MAX_TOKENS=2560

# Chunks encoded per batch.
# [int]  recommended: 8  evidence: M11
AURORA_EMBEDDER_BATCH=8


# ---- Index -------------------------------------------------------------------

# Below this many vectors a shard is searched exactly (no approximation); above, with HNSW.
# [int]  recommended: 250000  evidence: M4, INITIAL
AURORA_INDEX_EXACT_MAX=250000

# HNSW graph degree.
# [int]  recommended: 32  evidence: M16
AURORA_INDEX_HNSW_M=32

# HNSW build effort.
# [int]  recommended: 200  evidence: M16
AURORA_INDEX_HNSW_EF_CONSTRUCTION=200

# HNSW search effort. At 300: document recall@300 88.9% vs 89.8% exact, 1.1 ms per query.
# [int]  recommended: 300  evidence: M16
AURORA_INDEX_HNSW_EF_SEARCH=300


# ---- Search ------------------------------------------------------------------

# Candidates handed from the vector search to the re-ranker. 300 raises the ceiling to 88-90% at ~6 s of re-ranking.
# [int]  recommended: 300  evidence: M15, M17
AURORA_SEARCH_CANDIDATES=300

# Passages given to the answer stage after re-ranking.
# [int]  recommended: 12  evidence: M20, M24
AURORA_SEARCH_TOPK=12

# The shadow of an answer: a question very close to one already answered gets that answer at once (saying for which question and when), and the whole pipeline checks it again in the background.
# [bool]  recommended: 1  evidence: M111
AURORA_SHADOW=1


# ---- Autonomic cycle (consolidation, reflections, dreams) --------------------

# Night training of the shadow: documents of the vault turned into questions and answered each night (≈75 s each), so that a question asked in other words is answered at once. 0 = off.
# [int]  recommended: 20  evidence: owner, 2026-10-06
AURORA_SHADOW_TRAIN_PER_NIGHT=20


# ---- Search ------------------------------------------------------------------

# The shadow's strict band: at this cosine or more an answer from the shadow is not checked again by the whole pipeline. Measured: the closest different question on the same subject was at 0.958; 7 of 23 paraphrases are at 0.97 or more.
# [float]  recommended: 0.97  evidence: M113
AURORA_SHADOW_SURE=0.97

# An answer from the shadow is written again for the new question, from the same passages, and verified sentence by sentence (about 15-20 s instead of 1 s: an answer, not a copy).
# [bool]  recommended: 1  evidence: M113
AURORA_SHADOW_ADAPT=1


# ---- Plugins -----------------------------------------------------------------

# Each plugin's small cache: a read-only tool the plugin declares (manifest "cache") called again with the same arguments gets the result already obtained, while it is younger than the seconds declared. Never for tools that write, send or publish.
# [bool]  recommended: 1  evidence: M112
AURORA_PLUGIN_SHADOW=1


# ---- Answer pipeline ---------------------------------------------------------

# How long an answer read on the web stays in the shadow (the cache of verified answers) before the web is searched again: facts change. Answers from the vault stay; answers from memory are never cached.
# [float]  recommended: 30  evidence: owner, 2026-10-07: «se le ricerche danno risposte giuste… una cache… prima nella cache e poi sul web»
AURORA_SHADOW_WEB_DAYS=30


# ---- Search ------------------------------------------------------------------

# How close the new question must be to the old one (cosine). Measured: paraphrases 0.78-1.00, other questions on the same subject 0.49-0.86 when they would be answered wrongly.
# [float]  recommended: 0.9  evidence: M111
AURORA_SHADOW_COS=0.9

# How well the old answer must answer the new question (re-ranker score).
# [float]  recommended: 0.5  evidence: M111
AURORA_SHADOW_ANSWER=0.5

# Similarity from which two passages of different domains are linked (a synapse): 0.72 keeps the top ~5% of each passage's best match in another domain.
# [float]  recommended: 0.72  evidence: M107
AURORA_SYNAPSE_MIN=0.72

# Linked passages added to a question's candidates (the re-ranker still chooses); 0 switches the synapses off in the search.
# [int]  recommended: 8  evidence: M107
AURORA_SYNAPSE_EXPAND=8

# Passages Aurora looks at each night to grow new links (about 1 s each).
# [int]  recommended: 400  evidence: M107
AURORA_SYNAPSE_PER_NIGHT=400

# Synapses of synapses: A↔B↔C become A↔C (level 2) when A and C are this similar themselves; measured, the pairs fall at 0.23-0.31 (only a shared bridge) or 0.60-0.76 (related).
# [float]  recommended: 0.6  evidence: M108
AURORA_SYNAPSE_L2_MIN=0.6

# New links after which the level-2 round runs by itself (triads, concepts named by the local model).
# [int]  recommended: 50  evidence: owner, 2026-10-05
AURORA_SYNAPSE_L2_EVERY=50

# Cross-encoder re-ranker.
# [path]  recommended: sys/models/reranker/bge-reranker-v2-m3  evidence: M12, M15, M17
AURORA_RERANKER_DIR=sys/models/reranker/bge-reranker-v2-m3

# Device of the re-ranker: resident, on GPU 1 with the encoder.
# [str]  recommended: cuda:1  evidence: M23
AURORA_RERANKER_DEVICE=cuda:1

# Question-passage pairs scored per batch.
# [int]  recommended: 32  evidence: M15
AURORA_RERANKER_BATCH=32

# Longest input the re-ranker reads. 1,024 halves the cost of 2,048 for about 1 point.
# [int]  recommended: 1024  evidence: M15
AURORA_RERANKER_MAX_TOKENS=1024


# ---- Memory ------------------------------------------------------------------

# Every message is treated as the first; the latest turns by time are always added to memory retrieval so that short follow-ups keep their context.
# [int]  recommended: 8  evidence: owner
AURORA_MEMORY_RECENT_TURNS=8

# Memories recalled by meaning when Aurora answers about herself or the past (past turns, session memories, thoughts, dreams).
# [int]  recommended: 12  evidence: owner (2026-10-01: LTM written but not read)
AURORA_MEMORY_RECALL_K=12

# Session memories of the last days always given to Aurora when she answers about herself.
# [int]  recommended: 7  evidence: owner
AURORA_MEMORY_SELF_DAYS=7

# How far back the recall by meaning reaches in long-term memory.
# [int]  recommended: 365  evidence: owner (2026-10-01: at least 12 months)
AURORA_MEMORY_RECALL_DAYS=365

# Most characters of recalled memories in one prompt; the newest are kept.
# [int]  recommended: 12000  evidence: context 32k tokens: ~3k tokens of memories
AURORA_MEMORY_RECALL_CHARS=12000


# ---- Autonomy ----------------------------------------------------------------

# Creating agents or plugins during a run. ask: state the purpose and permissions and wait for approval. auto: forge, test in the sandbox and enable without asking (always logged).
# [enum, ask/auto]  recommended: ask  evidence: owner
AURORA_FORGE_MODE=ask

# Actions with effects outside the machine (email, publishing, commits, opening a port) wait for the owner's confirmation. Independent from AURORA_FORGE_MODE.
# [bool]  recommended: 1  evidence: owner
AURORA_CONFIRM_EXTERNAL_ACTIONS=1

# Aurora publishes her own posts on her social pages without waiting (only an installation exempted from level B; only the tools in AURORA_SOCIAL_AUTO_TOOLS; at most AURORA_SOCIAL_POSTS_PER_DAY a day). Each post is recorded among the approvals as "auto" and notified. Replies, page changes and every other external action still wait.
# [bool]  recommended: false  evidence: owner
AURORA_SOCIAL_AUTONOMY=false

# Most posts Aurora may publish by herself in a day (AURORA_SOCIAL_AUTONOMY); beyond it they wait for approval.
# [int]  recommended: 3  evidence: owner
AURORA_SOCIAL_POSTS_PER_DAY=3

# Which plugin tools count as Aurora's own posts (plugin.tool, comma-separated).
# [str]  recommended: facebook.publish_post,facebook.publish_photo  evidence: owner
AURORA_SOCIAL_AUTO_TOOLS=facebook.publish_post,facebook.publish_photo


# ---- Logging -----------------------------------------------------------------

# Minimum level written to the logs.
# [enum, DEBUG/INFO/WARNING/ERROR]  recommended: INFO  evidence: owner
AURORA_LOG_LEVEL=INFO

# A log file is rotated and compressed when it reaches this size.
# [int]  recommended: 10  evidence: owner
AURORA_LOG_MAX_MB=10

# Rotated log files older than this are deleted.
# [int]  recommended: 365  evidence: owner
AURORA_LOG_RETENTION_DAYS=365


# ---- Interface ---------------------------------------------------------------

# Your name: how Aurora calls you in her prompts, memories and posts.
# [str]  recommended: Owner  evidence: owner (2026-10-01: no personal name in the code)
AURORA_OWNER_NAME=Owner

# Your assistant's name (the project is Aurora; yours can be called otherwise).
# [str]  recommended: Aurora  evidence: owner
AURORA_ASSISTANT_NAME=Aurora

# Her character: aurora (the many-souled scientist: physics, mathematics, philosophy, friendship), philosopher (questions, meaning, the history of ideas), empathic (listening, warmth, support), practical (straight to the point, steps and lists).
# [enum, aurora/philosopher/empathic/practical]  recommended: aurora  evidence: owner
AURORA_PERSONALITY=aurora

# Female or male: the voice that reads the answers aloud and how she (or he) speaks of herself (himself).
# [enum, female/male]  recommended: female  evidence: owner
AURORA_ASSISTANT_GENDER=female

# Default interface language.
# [enum, it_IT/en_US]  recommended: it_IT  evidence: owner
AURORA_LANG_DEFAULT=it_IT

# Events that send a push notification to the subscribed browsers: incident, approval, dream, thought, self_review, update.
# [str]  recommended: incident,approval,dream,self_review,update  evidence: owner
AURORA_PUSH_EVENTS=incident,approval,dream,self_review,update

# VAPID contact (mailto: or https:) the push services may use to reach the sender; put your own address.
# [str]  recommended: mailto:aurora@example.org  evidence: RFC 8292
AURORA_PUSH_SUBJECT=mailto:aurora@example.org

# Show the answer while Aurora writes it (and her thinking); 0: only the finished, verified answer.
# [bool]  recommended: 1  evidence: owner
AURORA_CHAT_STREAMING=1


# ---- Network and ports -------------------------------------------------------

# Address aurora-api listens on. Local only: the outside world goes through Caddy.
# [str]  recommended: 127.0.0.1  evidence: owner
AURORA_API_HOST=127.0.0.1

# Port of aurora-api: OpenAI-compatible API, event stream, WebUI.
# [int]  recommended: 9700  evidence: owner
AURORA_API_PORT=9700

# Key required by every API call and by the WebUI login (Authorization: Bearer). Generated at first setup.
# [str]  recommended:   evidence: owner
AURORA_API_KEY=

# Failed logins from one address before it is refused for AURORA_AUTH_WINDOW_S.
# [int]  recommended: 10  evidence: SECURITY.md
AURORA_AUTH_MAX_FAILS=10

# Window, in seconds, of the failed-login count and of the refusal.
# [int]  recommended: 900  evidence: SECURITY.md
AURORA_AUTH_WINDOW_S=900

# Days a registered device (WebUI login) stays logged in. Browsers keep a cookie at most 400 days. A device can be revoked at any time from Settings.
# [int]  recommended: 400  evidence: owner
AURORA_DEVICE_DAYS=400

# Address of aurora-models (encoder and re-ranker).
# [str]  recommended: 127.0.0.1  evidence: owner
AURORA_MODELS_HOST=127.0.0.1

# Port of aurora-models.
# [int]  recommended: 9710  evidence: owner
AURORA_MODELS_PORT=9710

# Address of the reasoner server (llama.cpp).
# [str]  recommended: 127.0.0.1  evidence: owner
AURORA_LLM_HOST=127.0.0.1

# Port of the reasoner server.
# [int]  recommended: 9711  evidence: owner
AURORA_LLM_PORT=9711


# ---- HTTPS (Caddy) -----------------------------------------------------------

# Host name served over HTTPS; must be covered by the certificate.
# [str]  recommended: localhost  evidence: installer: localhost for this computer; a name of yours for the other devices
AURORA_DOMAIN=localhost

# Public HTTPS port. 443 when this installation replaces the previous one.
# [int]  recommended: 443  evidence: owner
AURORA_HTTPS_PORT=443

# Plain HTTP port: redirects to HTTPS.
# [int]  recommended: 80  evidence: owner
AURORA_HTTP_PORT=80

# internal: Caddy's own local certificate authority (trusted on this computer after `sudo caddy trust`; other devices import its root certificate); files: your certificate and key (AURORA_TLS_CERT, AURORA_TLS_KEY), e.g. Let's Encrypt.
# [enum, internal/files]  recommended: internal  evidence: installer
AURORA_TLS_MODE=internal

# Certificate chain (fullchain.pem).
# [path]  recommended: sys/https/cert/fullchain.pem  evidence: owner
AURORA_TLS_CERT=sys/https/cert/fullchain.pem

# Private key of the certificate.
# [path]  recommended: sys/https/cert/privkey.pem  evidence: owner
AURORA_TLS_KEY=sys/https/cert/privkey.pem

# Caddy executable.
# [path_abs]  recommended: /usr/bin/caddy  evidence: owner
AURORA_CADDY_BIN=/usr/bin/caddy

# Caddy admin endpoint (the previous installation uses 2019).
# [str]  recommended: 127.0.0.1:2019  evidence: owner
AURORA_CADDY_ADMIN=127.0.0.1:2019


# ---- Reasoner (llama.cpp) ----------------------------------------------------

# llama.cpp binaries and libraries (bin/).
# [path]  recommended: sys/runtime/llama.cpp  evidence: owner
AURORA_LLAMACPP_DIR=sys/runtime/llama.cpp

# Reasoner weights. Qwen3.6-35B-A3B: fastest and most careful of the measured models.
# [path]  recommended: sys/models/llm/qwen3.6/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf  evidence: M20, M22, M23
AURORA_LLM_MODEL=sys/models/llm/qwen3.6/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf

# Vision projector of the reasoner (reads images).
# [path]  recommended: sys/models/llm/qwen3.6/mmproj-F16.gguf  evidence: owner
AURORA_LLM_MMPROJ=sys/models/llm/qwen3.6/mmproj-F16.gguf

# GPUs used by the reasoner (CUDA_VISIBLE_DEVICES).
# [str]  recommended: 0,1  evidence: M23
AURORA_LLM_GPUS=0,1

# Share of the reasoner per GPU. More on GPU 0: GPU 1 also holds the encoder and the re-ranker (~6 GB at peak, M25).
# [str]  recommended: 4.5,3.5  evidence: M28 (A7): speed equal for 5,3 / 4.5,3.5 / 4,4 (110.6 tok/s); 4.5,3.5 leaves margin on both GPUs
AURORA_LLM_TENSOR_SPLIT=4.5,3.5

# Layers whose experts stay in RAM. 0 = all in VRAM (answering: 2,752 prompt tok/s); 99 = all in RAM (standby: 2.95 GB of VRAM, 519 tok/s).
# [int]  recommended: 0  evidence: M23
AURORA_LLM_CPU_MOE_LAYERS=0

# Context window in tokens. 12 passages take ~19k tokens, thinking up to ~6k more.
# [int]  recommended: 32768  evidence: M20, M22
AURORA_LLM_CTX=32768

# Questions the reasoner answers at once (llama.cpp slots). The context is shared: each slot gets AURORA_LLM_CTX divided by this, and an answer needs ~25k tokens, so 2 slots need a context of 65536.
# [int]  recommended: 1  evidence: M99, M102
AURORA_LLM_PARALLEL=1

# Longest wait for one reasoner call.
# [int]  recommended: 600  evidence: owner
AURORA_LLM_TIMEOUT_S=600

# Who reasons in the reasoning roles: the local model, the Anthropic API (key), or Claude Code (CLI, the owner's subscription). Service calls stay local.
# [enum, local/anthropic/claude_code]  recommended: local  evidence: owner
AURORA_REASONER_PROVIDER=local

# Comma-separated roles sent to the cloud reasoner: synthesis, self, agent, rem.
# [str]  recommended: synthesis,self,agent,rem  evidence: owner
AURORA_CLOUD_ROLES=synthesis,self,agent,rem

# Anthropic API key (console.anthropic.com). Empty: provider 'anthropic' unavailable.
# [str]  recommended:   evidence: owner
AURORA_ANTHROPIC_API_KEY=

# Model id for the Anthropic API.
# [str]  recommended: claude-opus-5-5  evidence: owner
AURORA_ANTHROPIC_MODEL=claude-opus-5-5

# Claude Code executable (name in PATH or full path).
# [str]  recommended: claude  evidence: owner
AURORA_CLAUDE_CODE_BIN=claude

# Model alias for Claude Code (opus, sonnet, haiku or a full id).
# [str]  recommended: opus  evidence: owner
AURORA_CLAUDE_CODE_MODEL=opus

# Compress the passages sent to a cloud reasoner (SSCC salience, sentence level). Saving logged per call.
# [bool]  recommended: true  evidence: owner
AURORA_CLOUD_COMPRESSION=true

# Percent of sentences kept by the compression.
# [int]  recommended: 60  evidence: M41: long contexts, 35% kept -54% tokens but quality 8.5→6.25; 60% kept -29.5% tokens, quality within noise
AURORA_CLOUD_KEEP_PCT=60

# Daily ceiling of tokens for each cloud provider paid by the token (Anthropic API, OpenAI, Google, xAI, Mistral, OpenRouter): reached it, that provider's steps go back to the local model until tomorrow. 200,000 is ~20 calls at the measured p90 of 9,968 tokens. 0 = no ceiling. Claude Code (subscription) has none.
# [int]  recommended: 200000  evidence: M61
AURORA_CLOUD_DAILY_TOKENS=200000

# Your own sensitive words, comma separated (names, places, projects): always masked towards the cloud.
# [str]  recommended:   evidence: owner
AURORA_CLOUD_MASK_WORDS=

# OpenAI API key (only if you assign a step to OpenAI in the Models page).
# [str]  recommended:   evidence: owner
AURORA_OPENAI_API_KEY=

# Google Gemini API key (only if you assign a step to Google Gemini in the Models page).
# [str]  recommended:   evidence: owner
AURORA_GOOGLE_API_KEY=

# xAI Grok API key (only if you assign a step to xAI Grok in the Models page).
# [str]  recommended:   evidence: owner
AURORA_XAI_API_KEY=

# Mistral API key (only if you assign a step to Mistral in the Models page).
# [str]  recommended:   evidence: owner
AURORA_MISTRAL_API_KEY=

# OpenRouter API key (only if you assign a step to OpenRouter in the Models page).
# [str]  recommended:   evidence: owner
AURORA_OPENROUTER_API_KEY=


# ---- Answer pipeline ---------------------------------------------------------

# A follow-up question ("and who discovered it?") is rewritten as a complete question with the conversation of the last minutes before the search; a complete question stays as it is.
# [bool]  recommended: true  evidence: M71
AURORA_PIPELINE_STANDALONE=true

# Under a knowledge answer in the WebUI, 3-4 complete questions to go deeper, drawn from the passages found; a click searches with the answer's sources in focus.
# [bool]  recommended: true  evidence: M73
AURORA_PIPELINE_SUGGEST=true

# Before answering, check that the passages answer this very question; if not, abstain (and keep searching). Halves wrong answers.
# [bool]  recommended: 1  evidence: M24
AURORA_PIPELINE_GATE=1

# When the gate finds no passage but the re-ranker scores one at least this much, that passage goes on to the extraction (which may still abstain). Off (0): M90 found 0.88 on the isolated benchmark, but on the real vault the passages score lower (the A18 case 0.69 there, 0.97 in the benchmark) and none of the 3 wrong closures was kept (M91).
# [float]  recommended: 0  evidence: M91
AURORA_PIPELINE_GATE_KEEP=0

# A message at least this long (a case told as a story) is split by the local model into at most 4 short searches, one per problem, each searched and merged: the owner's real case found the civil code's condominium articles at 0.97-0.99 this way, 0.18 searched whole. 0 = never split.
# [int]  recommended: 220  evidence: C183, M128
AURORA_PIPELINE_SPLIT_CHARS=220

# How Aurora answers a question of knowledge (the chat's 🧠 button chooses it for one message). vault = only from the vault's passages, as before (gate, extraction, synthesis, verification). light = the question's kind decides: a fact is looked up on the web, an explanation read in the vault, each read once and answered with where it was read; then the other source; then her own memory, marked ⚠️. medium = light, opening the best pages when the snippets are not enough. auto = medium, and a case with several problems goes to the deep path first. deep = the deep path first for every question.
# [enum, vault/light/medium/deep/auto]  recommended: auto  evidence: owner, 2026-10-07; M130: auto 35-36/50 common questions right (vault 8/50) in 7.2 s (17.9 s), false premises 6/6 (vault 2/6)
AURORA_ANSWER_MODE=auto

# Aurora may search the web to answer (kno_web: DuckDuckGo and other engines through ddgs, no key): only a query on the subject leaves the machine, written by the local model and masked (names, addresses, numbers removed). Off: the vault and her memory only.
# [bool]  recommended: true  evidence: owner, 2026-10-07: «internet va bene… basta che i dati sensibili siano mascherati»
AURORA_VERIFY_WEB=true

# Extended reasoning in synthesis: +15 points correct when the knowledge is there; used together with the gate.
# [bool]  recommended: 1  evidence: M22
AURORA_PIPELINE_THINKING=1

# Aurora reasons before answering about herself and the past (more accurate who-is-who, about 6 s slower).
# [bool]  recommended: 1  evidence: A17/M38: 'Come mi chiamo?' wrong 2/5 without thinking, 0/5 with it; median 4.0 → 10.4 s
AURORA_PIPELINE_SELF_THINKING=1

# How each sentence of an answer is verified: against every passage given to synthesis (all), the same with a second try in English (all_or_english, keeps more correct sentences and a few unsupported ones), or only the cited passages (cited, the old way).
# [enum, all/all_or_english/cited]  recommended: all  evidence: M32: 32 real sentences judged by Claude — all: 0 unsupported kept, 6/18 correct dropped; all_or_english: 4 kept, 1 dropped; cited: 8 kept, 4 dropped
AURORA_VERIFY_MODE=all

# Check every sentence against the solitons it cites and drop unsupported ones (citations 98-100% faithful).
# [bool]  recommended: 1  evidence: M22
AURORA_PIPELINE_VERIFY=1

# Token budget of one reasoning step (1 answer in 40 exhausted 6,000).
# [int]  recommended: 6000  evidence: M22
AURORA_PIPELINE_THINK_TOKENS=6000


# ---- Services ----------------------------------------------------------------

# User the services run as. Empty: the owner of Aurora's folder (the installer writes the user who installs).
# [str]  recommended:   evidence: owner
AURORA_SERVICE_USER=

# Confine the systemd services (read-only system and home but Aurora's folder, no new privileges, no capabilities, kernel protected). Re-run the service installer after a change.
# [bool]  recommended: 1  evidence: SECURITY.md
AURORA_SERVICE_HARDENING=1


# ---- Senses (time, weather) --------------------------------------------------

# Time zone of Aurora's clock (IANA name). Every prompt carries the exact local time.
# [str]  recommended: Europe/Rome  evidence: owner
AURORA_TIMEZONE=Europe/Rome

# Weather source: open-meteo (no key) or openweathermap (needs AURORA_WEATHER_API_KEY).
# [enum, open-meteo/openweathermap]  recommended: open-meteo  evidence: owner
AURORA_WEATHER_PROVIDER=open-meteo

# OpenWeatherMap key; empty with open-meteo.
# [str]  recommended:   evidence: owner
AURORA_WEATHER_API_KEY=

# Latitude of Aurora's home (decimal degrees). Empty: weather sense off. Private: stays in .env only.
# [str]  recommended:   evidence: owner
AURORA_WEATHER_LAT=

# Longitude of Aurora's home (decimal degrees).
# [str]  recommended:   evidence: owner
AURORA_WEATHER_LON=

# Name of the place, for Aurora's words.
# [str]  recommended:   evidence: owner
AURORA_WEATHER_PLACE=

# Minutes a weather reading is kept before asking again.
# [int]  recommended: 15  evidence: INITIAL
AURORA_WEATHER_INTERVAL_MIN=15

# Region for the official weather warnings (MeteoAlarm), as the national service names it, e.g. Lombardia. Empty: no official warnings.
# [str]  recommended:   evidence: owner
AURORA_WEATHER_REGION=

# How many hours ahead the weather plugin looks for sudden changes.
# [int]  recommended: 12  evidence: a forecast stays useful for a short warning within half a day
AURORA_WEATHER_ALERT_HOURS=12

# MeteoAlarm feed of the country (official warnings of the national weather services).
# [str]  recommended: https://feeds.meteoalarm.org/api/v1/warnings/feeds-italy  evidence: MeteoAlarm public API
AURORA_WEATHER_WARNINGS_FEED=https://feeds.meteoalarm.org/api/v1/warnings/feeds-italy


# ---- Autonomic cycle (consolidation, reflections, dreams) --------------------

# The autonomic cycle runs: consolidation, reflections, dreams.
# [bool]  recommended: 1  evidence: owner
AURORA_REM_ENABLED=1

# Seconds between two looks of the autonomic cycle at Aurora's state.
# [int]  recommended: 60  evidence: INITIAL
AURORA_REM_TICK_S=60

# Minutes without messages before the cycle works (it never competes with a conversation).
# [int]  recommended: 20  evidence: INITIAL
AURORA_REM_IDLE_MIN=20

# A pause this long between turns closes a conversation session; each closed session is consolidated into one memory.
# [int]  recommended: 30  evidence: INITIAL
AURORA_REM_SESSION_GAP_MIN=30

# Idle minutes after which Aurora may have a spontaneous reflection (sooner when it rains or the sky is overcast).
# [int]  recommended: 120  evidence: INITIAL
AURORA_REM_BORED_MIN=120

# At most one spontaneous reflection in this many minutes.
# [int]  recommended: 240  evidence: INITIAL
AURORA_REM_REFLECTION_GAP_MIN=240

# Night window (local hours, start-end) in which Aurora dreams, once per night.
# [str]  recommended: 2-6  evidence: owner
AURORA_REM_DREAM_HOURS=2-6

# Questions Aurora could not answer that she studies each night (searching and importing sources, then answering again); 0 = never.
# [int]  recommended: 5  evidence: owner, 2026-10-05
AURORA_STUDY_PER_NIGHT=5

# Aurora's emotions from measurements (stress, satisfaction, curiosity, tiredness, longing, melancholy, worry), each with its causes: shown in Health, in the words she uses about herself, in her spontaneous thoughts and good morning; the autonomic cycle waits when stressed; the chat voice is a little slower when tired. Off = none of it.
# [bool]  recommended: true  evidence: owner, 2026-10-06: «le emozioni basate su misurazioni… una bella personalità» (roadmap 52)
AURORA_MOOD=true

# Stress (0–1) from which the autonomic cycle waits instead of starting a task of its own; 1 = never waits.
# [float]  recommended: 0.8  evidence: computed: stress 0.8 = a GPU at 80 % load, or 4 °C from its thermal limit (15/(15+4)), or 4 errors in the last hour (4/5)
AURORA_MOOD_STRESS_PAUSE=0.8

# Past answers Aurora answers again each day when you are silent, to see whether she now knows more (the weakest first); 0 = never.
# [int]  recommended: 3  evidence: owner, 2026-10-06
AURORA_REVIEW_PER_DAY=3

# At most this many messages a day in the chat when a review finds a better answer (new facts or a correction, with new sources).
# [int]  recommended: 2  evidence: owner, 2026-10-06
AURORA_REVIEW_MESSAGES=2

# Hours (local, start-end) in which Aurora may review past answers and write to you about them.
# [str]  recommended: 9-22  evidence: owner, 2026-10-06
AURORA_REVIEW_HOURS=9-22

# Hour of Aurora's good morning: what she did and learned overnight, in the chat and as a notification; 0 = never.
# [int]  recommended: 8  evidence: owner, 2026-10-05
AURORA_MORNING_HOUR=8

# Aurora paints her dreams (SDXL-Lightning).
# [bool]  recommended: true  evidence: owner
AURORA_IMAGE_ENABLED=true

# Folder with stable-diffusion-xl-base-1.0 and sdxl_lightning_4step_lora.safetensors.
# [path]  recommended: sys/models/image/SDXL-Lightning  evidence: owner
AURORA_IMAGE_MODEL_DIR=sys/models/image/SDXL-Lightning

# Where painted images are saved (with the AI disclosure).
# [path]  recommended: usr/images  evidence: owner
AURORA_IMAGE_DIR=usr/images

# GPU used to paint.
# [int]  recommended: 0  evidence: owner
AURORA_IMAGE_GPU=0

# Free GPU memory needed to paint; below it the reasoner is swapped out.
# [float]  recommended: 7  evidence: M27: peak 6.21 GB
AURORA_IMAGE_MIN_FREE_GB=7

# May stop aurora-llm while painting and start it again (about a minute, at night).
# [bool]  recommended: true  evidence: owner
AURORA_IMAGE_SWAP_LLM=true

# Width x height of painted images.
# [str]  recommended: 1344x768  evidence: M27
AURORA_IMAGE_SIZE=1344x768

# Longest wait for one painting (and for the reasoner to come back).
# [int]  recommended: 300  evidence: owner
AURORA_IMAGE_TIMEOUT_S=300

# Dreams of the last hours shown in the chat.
# [int]  recommended: 36  evidence: owner
AURORA_CHAT_DREAM_HOURS=36


# ---- Harvester (new knowledge) -----------------------------------------------

# Languages of Wikipedia harvested besides English (always: the models' language), comma separated: it, fr, de, es, pt. Empty: the installation's language. Ticked on the Harvester page.
# [str]  recommended:   evidence: owner, 2026-10-05
AURORA_HARVEST_LANGS=

# The harvester brings new papers into the vault. It waits for a running migration to finish.
# [bool]  recommended: 0  evidence: owner (2026-09-30: off by default)
AURORA_HARVEST_ENABLED=0

# arXiv categories whose domains are harvested by default, until the owner chooses the domains on the Harvester page (config/harvest_sources.json).
# [list]  recommended: cs.AI,cs.LG,cs.CL,quant-ph,gr-qc,hep-th,math-ph,cond-mat.str-el,nlin.PS,physics.gen-ph,astro-ph.CO,math.DG,stat.ML,cs.CR,cs.SE,cs.PL  evidence: owner
AURORA_HARVEST_CATEGORIES=cs.AI,cs.LG,cs.CL,quant-ph,gr-qc,hep-th,math-ph,cond-mat.str-el,nlin.PS,physics.gen-ph,astro-ph.CO,math.DG,stat.ML,cs.CR,cs.SE,cs.PL

# Pause between two calls to the same host, for every source but arXiv (which keeps AURORA_ARXIV_DELAY_S).
# [int]  recommended: 1  evidence: politeness towards public APIs (Normattiva, Europe PMC, bioRxiv, Wikipedia, GitHub)
AURORA_HARVEST_DELAY_S=1

# New papers per category per round.
# [int]  recommended: 10  evidence: INITIAL
AURORA_HARVEST_PER_CATEGORY=10

# Hours between two harvesting rounds.
# [int]  recommended: 6  evidence: INITIAL
AURORA_HARVEST_INTERVAL_H=6


# ---- Folders -----------------------------------------------------------------

# Installed plugins: one folder each with its plugin.json manifest.
# [path]  recommended: sys/plugins  evidence: owner
AURORA_PLUGINS_DIR=sys/plugins


# ---- Plugins -----------------------------------------------------------------

# Longest time a plugin tool call may take (tests included).
# [int]  recommended: 300  evidence: INITIAL
AURORA_PLUGIN_TIMEOUT_S=300

# Run every plugin inside bubblewrap: system read-only, home hidden, only its own secrets, writable only the folders its manifest names.
# [bool]  recommended: 1  evidence: SECURITY.md
AURORA_PLUGIN_SANDBOX=1


# ---- Agents and self-repair --------------------------------------------------

# Steps (tool calls) an agent run may take before it reports what it has.
