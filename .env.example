AURORA_PROJECTS_DIR=usr/projects

# Longest run of a command (tests, a program) in a local project, in its cage with no network; then it is stopped.
# [int]  recommended: 120  evidence: owner
AURORA_PROJECT_RUN_S=120

# Author name of Aurora's commits.
