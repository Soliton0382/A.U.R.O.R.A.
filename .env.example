# Access token of the owner's Mastodon account (read and write:statuses).
# [str]  recommended:   evidence: owner
AURORA_MASTODON_TOKEN=


# ---- Network security (firewall) ---------------------------------------------

# Address:port where the firewall's syslog (UDP) is received. To receive from the LAN use the machine's LAN address: opening the port is the owner's decision.
# [str]  recommended: 127.0.0.1:5514  evidence: owner
AURORA_SENTINEL_BIND=127.0.0.1:5514

# Addresses allowed to send syslog (the firewall); anything else is dropped.
# [list]  recommended: 127.0.0.1  evidence: owner
AURORA_SENTINEL_ALLOW=127.0.0.1

# Sliding window of the detector, in minutes.
# [int]  recommended: 5  evidence: INITIAL
AURORA_SENTINEL_WINDOW_MIN=5

# Denied connections from one source within the window that make an incident.
# [int]  recommended: 50  evidence: INITIAL
AURORA_SENTINEL_DENY_THRESHOLD=50

# Distinct destination ports from one source within the window that make a port-scan incident.
# [int]  recommended: 20  evidence: INITIAL
AURORA_SENTINEL_SCAN_PORTS=20

# Investigate every incident at once (public registry data, report, recommended actions).
# [bool]  recommended: 1  evidence: owner
AURORA_SENTINEL_INVESTIGATE=1

# The firewall's official syslog documentation: Aurora reads it with the traffic the firewall really sends and proposes what to watch (Security page).
# [str]  recommended: https://docs.sophos.com/nsg/sophos-firewall/22.0/syslog/index.html  evidence: owner
AURORA_SECURITY_SYSLOG_DOC=https://docs.sophos.com/nsg/sophos-firewall/22.0/syslog/index.html

# The firewall's official administrator help: Aurora keeps it indexed on this machine (never published) and reads it before every operation on the firewall. A new firmware: change the version in the link.
# [str]  recommended: https://docs.sophos.com/nsg/sophos-firewall/22.0/Help/en-us/webhelp/onlinehelp/index.html  evidence: owner, 2026-10-07
AURORA_FIREWALL_MANUAL_URL=https://docs.sophos.com/nsg/sophos-firewall/22.0/Help/en-us/webhelp/onlinehelp/index.html

# The firewall's XML API reference: the sample request of each operation is what Aurora follows to write rules and NAT.
# [str]  recommended: https://docs.sophos.com/nsg/sophos-firewall/22.0/api/index.html  evidence: owner, 2026-10-07
AURORA_FIREWALL_API_DOC_URL=https://docs.sophos.com/nsg/sophos-firewall/22.0/api/index.html

# Addresses of the house allowed to touch many devices or call outside regularly (your network scanner, a monitoring server), comma separated: the threat hunt leaves them out.
# [str]  recommended:   evidence: owner, 2026-10-07
AURORA_HUNT_IGNORE=

# Aurora may change the firewall beyond her blocking group: publish a server (NAT and rule), put a device in quarantine, apply an IPS policy. Every change waits for your approval, starts from a saved copy and is undone by itself if the firewall stops answering.
# [bool]  recommended: 0  evidence: owner, 2026-10-07
AURORA_FIREWALL_WRITE=0

# Seconds after a change in which the firewall must still answer Aurora's API, or the change is undone (like a router's «commit confirmed»).
# [int]  recommended: 60  evidence: owner, 2026-10-07
AURORA_FIREWALL_CONFIRM_S=60

# The firewall's group of the devices in quarantine: a rule made once by Aurora (with your approval) drops all their traffic but towards the firewall itself.
# [str]  recommended: Aurora-Quarantine  evidence: owner, 2026-10-07
AURORA_QUARANTINE_GROUP=Aurora-Quarantine

# The firewall API's dialect (sophos: the XML API of Sophos firewalls; others to come).
# [enum, sophos]  recommended: sophos  evidence: owner
AURORA_FIREWALL_API_KIND=sophos

# The firewall's API address: https://address:port only, e.g. https://172.16.16.16:4444 (the admin console's port). Empty: no action on the firewall. Turn the API on there and allow this machine's address.
# [str]  recommended:   evidence: owner
AURORA_FIREWALL_API_URL=

# The firewall API's user (best a dedicated administrator with only the rights it needs).
# [str]  recommended:   evidence: owner
AURORA_FIREWALL_API_USER=

# The firewall API's password.
# [str]  recommended:   evidence: owner
AURORA_FIREWALL_API_PASSWORD=

# Check the firewall's HTTPS certificate (off for a firewall's own self-signed one).
# [bool]  recommended: 0  evidence: owner
AURORA_FIREWALL_VERIFY_TLS=0

# Host group on the firewall where the addresses you block go; make once a rule that drops traffic from this group (Aurora never writes rules).
# [str]  recommended: Aurora-Blocklist  evidence: owner
AURORA_FIREWALL_BLOCK_GROUP=Aurora-Blocklist

# Defence on an attack: suggest (the incident shows ⛔, you decide), auto (Aurora blocks the source on the firewall by herself, within the limits below, for AURORA_DEFENCE_HOURS; only an installation exempted from level B; never an address of the local network), off.
# [enum, suggest/auto/off]  recommended: suggest  evidence: owner, 2026-10-05
AURORA_DEFENCE_MODE=suggest

# How long an automatic block lasts; then Aurora lifts it by herself.
# [int]  recommended: 24  evidence: owner, 2026-10-05
AURORA_DEFENCE_HOURS=24

# The least severity of an incident Aurora blocks by herself.
# [enum, high/medium]  recommended: high  evidence: owner, 2026-10-05
AURORA_DEFENCE_MIN_SEVERITY=high

# Most automatic blocks in a day; beyond it the incidents wait for you.
# [int]  recommended: 20  evidence: owner, 2026-10-05
AURORA_DEFENCE_MAX_PER_DAY=20

# Public lists of known attackers (Spamhaus DROP, abuse.ch Feodo, FireHOL level1), downloaded once a day: an incident from a listed address becomes high.
# [bool]  recommended: 1  evidence: owner, 2026-10-06
AURORA_INTEL_ENABLED=1

# Days each device of the house is only watched (countries, ports, apps, data sent) before something it never did is told.
# [int]  recommended: 7  evidence: owner, 2026-10-06
AURORA_BASELINE_DAYS=7

# Decoy ports on Aurora's machine (nothing real listens there): whoever opens one is a high incident, and kept off this machine. Empty: no decoy.
# [str]  recommended: 2222,2323,8088  evidence: owner, 2026-10-06
AURORA_HONEYPOT_PORTS=2222,2323,8088

# Aurora's own firewall on this machine (nftables, through /usr/local/sbin/aurora-nft installed with sudo bash sys/deploy/nft/install.sh): a decoy touched or a login lockout, the address off this machine for some hours; never a protected address.
# [bool]  recommended: 1  evidence: owner, 2026-10-06
AURORA_HOSTFW=1

# Hours an address stays off Aurora's machine.
# [int]  recommended: 24  evidence: owner, 2026-10-06
AURORA_HOSTFW_HOURS=24

# Addresses or networks Aurora never blocks by herself, comma separated (e.g. 192.0.2.10, 198.51.100.0/24): your own devices outside, your office.
# [str]  recommended:   evidence: owner, 2026-10-05
AURORA_DEFENCE_PROTECTED=

# AbuseIPDB API key for IP reputation (optional).
# [str]  recommended:   evidence: owner
AURORA_ABUSEIPDB_KEY=


# ---- Plugins -----------------------------------------------------------------

# Brave Search API key for web search (optional).
# [str]  recommended:   evidence: owner
AURORA_BRAVE_SEARCH_KEY=

# IMAP server of the owner's mailbox, host[:port] (TLS, default 993).
# [str]  recommended:   evidence: owner
AURORA_EMAIL_IMAP_HOST=

# SMTP server, host[:port] (465 TLS or 587 STARTTLS).
# [str]  recommended:   evidence: owner
AURORA_EMAIL_SMTP_HOST=

# Mailbox user (address).
# [str]  recommended:   evidence: owner
AURORA_EMAIL_USER=

# Mailbox password or app password.
# [str]  recommended:   evidence: owner
AURORA_EMAIL_PASSWORD=

# Home Assistant address (https://... recommended).
# [str]  recommended:   evidence: owner
AURORA_HA_URL=

# Home Assistant long-lived access token.
# [str]  recommended:   evidence: owner
AURORA_HA_TOKEN=


# ---- Documents (PDF) ---------------------------------------------------------

# Where Aurora keeps the documents (PDF) she writes.
# [path]  recommended: usr/documents  evidence: owner
AURORA_DOCUMENTS_DIR=usr/documents


# ---- Logging -----------------------------------------------------------------

# Where the bug reports are written (zip, 0600): the owner's description and the logs needed, with private data masked.
# [path]  recommended: usr/bugreports  evidence: owner
AURORA_BUGREPORT_DIR=usr/bugreports


# ---- Documents (PDF) ---------------------------------------------------------

# Chrome or Chromium executable, used headless to print documents to PDF.
# [path_abs]  recommended: /usr/bin/google-chrome  evidence: owner
AURORA_CHROME_BIN=/usr/bin/google-chrome


# ---- Services ----------------------------------------------------------------

# Updates from the GitHub repository: notify (you read the list of changes and approve), auto (applied when safe: no protected file, tests green; otherwise it asks), off.
# [enum, notify/auto/off]  recommended: notify  evidence: owner
AURORA_UPDATE_MODE=notify

# Hours between two update checks.
# [int]  recommended: 24  evidence: owner
AURORA_UPDATE_INTERVAL_H=24

# Git remote the updates come from.
# [str]  recommended: origin  evidence: git
AURORA_UPDATE_REMOTE=origin

# Branch followed for updates.
# [str]  recommended: main  evidence: git
AURORA_UPDATE_BRANCH=main

# Apply only commits signed by a key in sys/core/config/allowed_signers (the local copy: an update cannot bring its own signer).
# [bool]  recommended: 1  evidence: SECURITY.md
AURORA_UPDATE_REQUIRE_SIGNED=1


# ---- Plugins -----------------------------------------------------------------

# Camera Aurora uses (/dev/videoN), or auto for the first one found.
# [str]  recommended: auto  evidence: owner
AURORA_SENSES_CAMERA=auto

# Microphone Aurora uses (PipeWire source name), or auto for the first one found.
# [str]  recommended: auto  evidence: owner
AURORA_SENSES_MIC=auto

# Size of the photos taken by the camera.
# [str]  recommended: 1280x720  evidence: measured: 1.2 s per photo on an HP 320 FHD
AURORA_SENSES_PHOTO_SIZE=1280x720

# Longest recording, in seconds.
# [int]  recommended: 30  evidence: owner
AURORA_SENSES_LISTEN_MAX_S=30

# Speech-to-text model (Whisper), run on the CPU.
# [path]  recommended: sys/models/stt/whisper-large-v3-turbo  evidence: measured on CPU: 13 s of English speech in 5.2 s, exact
AURORA_STT_MODEL_DIR=sys/models/stt/whisper-large-v3-turbo


# ---- Interface ---------------------------------------------------------------

# Aurora's voice made on this machine (Piper, on the CPU) for the devices with no voice of their own: the text never leaves the house.
# [bool]  recommended: 1  evidence: M114
AURORA_TTS=1

# Speed of Aurora's voice: above 1 slower, below 1 faster (Piper's length scale).
# [float]  recommended: 1.08  evidence: owner, 2026-10-06: sample 3 «Piper C, stabile e lenta» for the chat
AURORA_TTS_LENGTH=1.08

# Variation of the voice's sound: lower is steadier and less wobbly, higher more expressive (Piper's noise scale).
# [float]  recommended: 0.5  evidence: owner, 2026-10-06: sample 3 «Piper C, stabile e lenta» for the chat
AURORA_TTS_NOISE=0.5

# Variation of the voice's rhythm: lower is more even, higher more lively (Piper's noise width).
# [float]  recommended: 0.6  evidence: owner, 2026-10-06: sample 3 «Piper C, stabile e lenta» for the chat
AURORA_TTS_NOISE_W=0.6

# Seconds of silence after each sentence.
# [float]  recommended: 0.35  evidence: owner, 2026-10-06: sample 3 «Piper C, stabile e lenta» for the chat
AURORA_TTS_PAUSE=0.35

# Aurora's voice in the chat: piper = on the CPU, instant (the owner's choice); qwen = natural, on the GPU only when it has room.
# [enum, qwen/piper]  recommended: piper  evidence: owner, 2026-10-06: the chat with Piper (sample 3), the natural voice for the videos; C173
AURORA_TTS_ENGINE=piper

# The voice of Aurora's videos: qwen = natural (on the CPU, ~4 s of work per second of speech), piper = the classic one.
# [enum, qwen/piper]  recommended: qwen  evidence: owner, 2026-10-06: sample 5 «Qwen clone» for the videos
AURORA_VIDEO_VOICE=qwen

# The clip the natural voice clones (its words in the .txt beside it): private, never published; the installer makes one if missing.
# [path]  recommended: sys/status/voice/aurora_ref.flac  evidence: owner, 2026-10-06: «almeno la voce la vorrei solo mia»
AURORA_TTS_QWEN_REF=sys/status/voice/aurora_ref.flac

# The GPU of the natural voice (it is closed before any picture or video job).
# [int]  recommended: 1  evidence: owner, 2026-10-06 («la 5! è la voce di Aurora»), M122
AURORA_TTS_GPU=1

# The natural voice's model (config/models.json "tts_qwen").
# [path]  recommended: sys/models/tts/qwen3-tts-0.6b  evidence: owner, 2026-10-06 («la 5! è la voce di Aurora»), M122
AURORA_TTS_QWEN_DIR=sys/models/tts/qwen3-tts-0.6b

# The natural voice's own packages (its transformers is not Aurora's).
# [path]  recommended: sys/runtime/qwen-tts/pkgs  evidence: owner, 2026-10-06 («la 5! è la voce di Aurora»), M122
AURORA_TTS_QWEN_RUNTIME=sys/runtime/qwen-tts/pkgs

# Seconds of silence after which the natural voice is closed and its GPU memory given back.
# [int]  recommended: 600  evidence: owner, 2026-10-06 («la 5! è la voce di Aurora»), M122
AURORA_TTS_QWEN_IDLE_S=600

# Free memory (GB) the natural voice needs on its GPU before it is loaded for the chat: its 3.5 GB plus room for the re-ranker; less, and Piper speaks.
# [float]  recommended: 5.0  evidence: M122, C173: the voice takes 3.5 GB; the re-ranker failed with 0.47 GB free
AURORA_TTS_QWEN_MIN_FREE_GB=5.0

# The Piper program (GPL-3: in its own environment, made by script/sys_tts_install.sh; never imported into Aurora).
# [path]  recommended: sys/runtime/piper/bin/piper  evidence: M114
AURORA_TTS_BIN=sys/runtime/piper/bin/piper

# The voices (config/models.json "tts"): Italian paola, English ljspeech.
# [path]  recommended: sys/models/tts/piper-voices  evidence: M114
AURORA_TTS_DIR=sys/models/tts/piper-voices


# ---- Backup (encrypted, to another disk) -------------------------------------

# Where the nightly backup goes: a folder on ANOTHER disk (absolute path) or on the NAS as smb://address/share/folder (the backup plugin mounts it). Not inside Aurora's folder. Empty: no backup.
# [str]  recommended:   evidence: owner
AURORA_BACKUP_DIR=

# NAS user for an smb:// backup folder (kept by root in /etc/aurora/nas.cred, never in fstab).
# [str]  recommended:   evidence: owner
AURORA_NAS_USER=

# NAS password for an smb:// backup folder.
# [str]  recommended:   evidence: owner
AURORA_NAS_PASSWORD=

# Mount the NAS at every start (one line in /etc/fstab, with nofail: a NAS switched off never blocks the computer).
# [bool]  recommended: true  evidence: owner
AURORA_NAS_FSTAB=true

# The backup's encryption key (32 bytes, 0600), outside Aurora's folder. Made once by `svc_backup.py init`, which shows its recovery code: keep that code outside this computer.
# [str]  recommended: ~/.config/aurora/backup.key  evidence: owner
AURORA_BACKUP_KEY_FILE=~/.config/aurora/backup.key

# When the backup runs every night (HH:MM). A night the computer was off, it runs at the next start.
# [str]  recommended: 03:30  evidence: owner
AURORA_BACKUP_TIME=03:30

# Daily snapshots kept (the newest of each day).
# [int]  recommended: 7  evidence: owner
AURORA_BACKUP_KEEP_DAILY=7

# Weekly snapshots kept.
# [int]  recommended: 4  evidence: owner
AURORA_BACKUP_KEEP_WEEKLY=4

# Monthly snapshots kept.
# [int]  recommended: 6  evidence: owner
AURORA_BACKUP_KEEP_MONTHLY=6


# ---- Users -------------------------------------------------------------------

# Who uses Aurora. "single": one person, the admin. "multi": several people, each with their folder usr/<name>, their .env (accounts, tokens, place) and their private memory (chats, dreams and reflections, shareable); the login asks for name, password and the Authenticator app's code; plugins and knowledge stay everyone's, the machine's settings only the admin changes. Change it whenever you like: from single to multi nothing moves; from multi to single the other users are DELETED with all their data (folder, memory, devices, log lines), after the list of what goes and your confirmation; the admin's data is never touched. To pass to "multi" first set your password and link the Authenticator app in 👥 Users → My account (else you would be locked out); then create the users in 👥 Users. Aurora's key stays the admin's spare way in.
# [enum, single/multi]  recommended: single  evidence: owner
AURORA_USER_MODE=single

# In multi-user mode the login asks, besides the password, for the 6-digit code of the Google Authenticator app (the only one tested). At the first login Aurora shows the QR code to scan. Not advised to switch it off.
# [bool]  recommended: true  evidence: owner
AURORA_USERS_MFA=true


# ---- Plugins -----------------------------------------------------------------

# Meal reminders from the diet plan (Health → Diet, after «Process documents»): at each meal's time a notification and a chat message with the dish proposed and an alternative. Off by default.
# [bool]  recommended: false  evidence: owner, 2026-10-07: «messaggi automatici in chat e alert (attivabili)» (roadmap 55)
AURORA_DIET_REMINDERS=false

# The meals' times for the reminders: meal=HH:MM separated by commas (colazione, spuntino, pranzo, merenda, cena). A meal left out has no reminder.
# [str]  recommended: colazione=07:30,pranzo=12:30,merenda=16:30,cena=19:30  evidence: owner, 2026-10-07 (roadmap 55): usual Italian meal times, each user changes theirs
AURORA_DIET_TIMES=colazione=07:30,pranzo=12:30,merenda=16:30,cena=19:30

# Cloudflare account ID (dashboard home): the cloudflare plugin works on it. Empty: plugin off.
# [str]  recommended:   evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with Cloudflare Tunnel: Edit and Zero Trust: Edit. Never shown, never sent to a model.
# [str]  recommended:   evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_API_TOKEN=

# Name of the Cloudflare tunnel of this computer.
# [str]  recommended: aurora  evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_TUNNEL=aurora

# The private address WARP reaches (IP/32); empty: this computer's own LAN address.
# [str]  recommended:   evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_NETWORK=

# Internal domain resolved by the home DNS also away (WARP local domain fallback), e.g. the domain of Aurora's address; empty: none.
# [str]  recommended:   evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_DOMAIN=

# The home DNS server that resolves that domain (an IP); WARP carries it too.
# [str]  recommended:   evidence: owner, 2026-10-07: «aurora sempre e ovunque raggiungibile… una sorta di ztna» (roadmap 56)
AURORA_CLOUDFLARE_DNS=
