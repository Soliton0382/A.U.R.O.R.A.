AURORA_AI_DISCLOSURE_EN=🤖 Content generated with artificial intelligence (Aurora).

# A small visible "AI · Aurora" label on generated images (the machine-readable mark is always there).
# [bool]  recommended: 1  evidence: owner
AURORA_AI_IMAGE_LABEL=1

# Owner's exemption from level B of the ethics code, signed for this machine only (never in git). Level A is always active.
# [path]  recommended: sys/core/ethics/exemption.sig  evidence: owner
AURORA_ETHICS_EXEMPTION=sys/core/ethics/exemption.sig


