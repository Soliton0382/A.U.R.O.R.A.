# Secrets and local configuration: .env holds values and credentials.
.env
.env.*
!.env.example

# Environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Aurora's data: models, vault, indexes, logs, runtime state, user files.
sys/models
sys/vault
sys/logs
sys/status
sys/tmp
sys/sandbox
usr

# Scratch space
tmp/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Built or downloaded by the installer: llama.cpp (sys_nvidia.sh llama), GitHub MCP server
sys/runtime

# The Android app's toolchain (JDK, SDK), its signing key and its build: on the machine that builds it (sys/app/build.py);
# the APK published is sys/app/dist
sys/app/tools
sys/app/keys
sys/app/out

# The owner's Claude Code workspace (personal paths and settings)
.claude/
CLAUDE.md

# Generated from .env (absolute paths): regenerate with sys/core/script/sys_install_services.py
sys/deploy/
sys/https/
# Signed per installation with its own key (/etc/aurora): never committed
sys/core/ethics/MANIFEST.json
sys/core/ethics/exemption.sig

# The installer's log (it shows the API key at the end)
install.log

# This installation's own extensions (the owner's, loaded when present): never published
sys/core/aurora/local/
sys/core/webui/js/local/
sys/core/webui/css/local/
sys/core/tests/local/
docs/local/
sys/plugins/local_*/

# a plugin's own libraries and programs (plg_deps, ROADMAP 101): fetched on install, never published
sys/plugins/*/.deps/
sys/plugins/*/.bin/
sys/plugins/*/.deps.tmp/
sys/plugins/*/.bin.tmp/
